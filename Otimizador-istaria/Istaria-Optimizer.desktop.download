#!/usr/bin/env xdg-open
[Desktop Entry]
Name=Istaria Performance Optimizer
Comment=Optimizer for Istaria: Chronicles of the Gifted
Exec=bash -c 'DIR="$(dirname "$(readlink -f "%k")")"; konsole -e bash -c "bash \"$DIR/instalar-otimizacoes.sh\"; exec bash"'
Icon=applications-games
Terminal=false
Type=Application
Categories=Game;
